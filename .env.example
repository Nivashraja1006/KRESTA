# ==========================================
# RestaurantIQ - Environment Configuration
# ==========================================

# Application
PROJECT_NAME=RestaurantIQ
VERSION=1.0.0
DEBUG=True

# Security
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL (Docker or local):
# Set DATABASE_URL in your private .env when using PostgreSQL.
# For SQLite (instant zero-dependency local run):
DATABASE_URL=sqlite:///./restaurantiq.db
POSTGRES_USER=restaurantiq
POSTGRES_PASSWORD=
POSTGRES_DB=restaurantiq_db

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# AI Providers (Optional: system runs with built-in grounded analytical engine if keys omitted)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=grounded_analytics

# Auto-seed realistic demo data on startup if database is empty
AUTO_SEED=True
DEMO_USER_PASSWORD=

# Frontend API URL
VITE_API_URL=http://localhost:8080
